#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=common.sh
source "$(cd "$(dirname "$0")" && pwd)/common.sh"

mkdir -p "$VERIFY_RHUMB_STATE_DIR"
PID_FILE="$VERIFY_RHUMB_STATE_DIR/local.pid"
if [[ -f "$PID_FILE" ]]; then
  pid="$(cat "$PID_FILE")"
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid"
    waited=0
    while kill -0 "$pid" 2>/dev/null && [[ "$waited" -lt 10 ]]; do
      sleep 1
      waited=$((waited + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid"
    fi
  fi
  rm -f "$PID_FILE"
fi

if [[ -d "$VERIFY_RHUMB_STATE_DIR" ]]; then
  rm -rf "$VERIFY_RHUMB_STATE_DIR"
fi

if [[ ! -d "$VERIFY_RHUMB_EVIDENCE_DIR" ]]; then
  echo "cleanup left no evidence at $VERIFY_RHUMB_EVIDENCE_DIR" >&2
  exit 1
fi

echo "cleanup removed state only. evidence remains at $VERIFY_RHUMB_EVIDENCE_DIR"
